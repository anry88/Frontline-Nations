      "targets": [{ "editorMode": "code", "expr": "sum by (pack) (increase(frontline_stars_purchase_total{job=~\"$job\",stage=\"completed\"}[$__range]))", "instant": true, "legendFormat": "{{pack}}", "range": false, "refId": "A" }],
