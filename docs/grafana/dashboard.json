      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Server responses with status 5xx during the selected dashboard range.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 44 },
      "id": 19,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(increase(http_server_requests_seconds_count{job=~\"$job\",status=~\"5..\"}[$__range]))", "instant": true, "legendFormat": "5xx", "range": false, "refId": "A" }],
