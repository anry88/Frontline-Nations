COMPOSE_PROJECT_NAME=frontline-nations-prod
FRONTLINE_IMAGE=frontline-nations:local
POSTGRES_DB=frontline
POSTGRES_USER=frontline
POSTGRES_PASSWORD=replace-with-a-random-secret
POSTGRES_DATA_DIR=./.runtime/postgres
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
BATTLE_SERVER_SALT=replace-with-a-random-secret
PUBLIC_BASE_URL=https://frontline-nations.tg-games.com
GAME_TIMEZONE=Europe/Belgrade
REPLAY_CACHE_DIRECTORY=/var/cache/frontline-replays
REPLAY_WIDTH=768
REPLAY_FPS=3
REPLAY_RETENTION_HOURS=48
REPLAY_WEEKLY_RETENTION_HOURS=168
CAMPAIGN_RESOLVE_CRON="0 0 15 * * SUN"
CAMPAIGN_RETRY_CRON="0 5/10 * * * *"
CAMPAIGN_OPEN_CRON="0 5 0 * * MON"
CAMPAIGN_MAX_TICKS=96
CAMPAIGN_OBJECTIVE_BASE_POINTS=1000
CAMPAIGN_OBJECTIVE_DECAY_PER_TICK=15
CAMPAIGN_OBJECTIVE_MIN_POINTS=200
CAMPAIGN_SURVIVOR_SCORE_PERCENT=50
CAMPAIGN_NPC_MIN_CP=10
CAMPAIGN_NPC_MAX_CP=25
CAMPAIGN_WINNER_XP=600
CAMPAIGN_LOSER_XP=250
CAMPAIGN_WINNER_CREDITS=90
CAMPAIGN_LOSER_CREDITS=30
CAMPAIGN_DESTROYED_CREDITS_PER100_POWER=1
CAMPAIGN_DESTROYED_XP_PER100_POWER=50
CAMPAIGN_CAPTURE_CREDITS=5
CAMPAIGN_CAPTURE_XP=100
CAMPAIGN_VICTORY_BONUS_PERCENT=120
CAMPAIGN_VICTORY_BONUS_DAYS=7
CAMPAIGN_WINNER_MATERIALS=30
CAMPAIGN_LOSER_MATERIALS=16
HDC_TUNNEL_NETWORK=hdc-tunnel
TUNNEL_APP_ALIAS=frontline-nations-prod-app
